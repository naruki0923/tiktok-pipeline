# Discord Bot の機密。discord.com/developers のアプリ→Bot からコピー
# このファイルを .env にコピーして値を入れる（.env はコミットしない）
DISCORD_BOT_TOKEN=ここにBotトークン

# 通知・操作を受け付けるチャンネルID（Discordで開発者モードON→チャンネル右クリック→IDをコピー）
# 空にすると、最初に話しかけたチャンネルを自動で覚える
DISCORD_CHANNEL_ID=

# 任意: 自分以外の操作を無視したい場合、自分のユーザーIDを入れる
DISCORD_ALLOWED_USER_ID=

# 任意: 動画が出来て「あとは投稿だけ」の時に @ で呼ぶ相手のユーザーID。
# 空なら DISCORD_ALLOWED_USER_ID → 最初に話しかけた人 の順に自動で使う
DISCORD_MENTION_USER_ID=

# 自動実行（毎日この時刻にリサーチ→台本→動画生成まで走る。投稿はしない）
AUTO_TIME=18:00
AUTO_ENABLED=1

# 生成でコケた時に Codex が直して自動で作り直す回数（0で従来どおり手動やり直し）。
# コードが直らなかった時（TikTok側の一時制限など）だけ AUTO_RETRY_WAIT 秒あける。
# ※投稿はこの対象外。TikTok/YouTubeへ出すのは今までどおり社長の合図が要る
AUTO_RETRY_MAX=2
AUTO_RETRY_WAIT=300

# 任意: 台本生成を従量課金のAnthropic APIで回したい場合だけ設定する。
# 未設定なら契約済みの claude CLI を使う（追加課金なし・こちらが既定）
# ANTHROPIC_API_KEY=
