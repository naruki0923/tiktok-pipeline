# プロジェクト共通の設定。`cp .env.example .env` して埋める。
# ⚠️ .env は .gitignore 済み。ここ（.env.example）に実際の値を書かないこと。

# 投稿先のTikTokアカウント名（@ は付けても付けなくてもよい）。
# コードとドキュメントには書かない。理由は 1_リサーチ/scripts/own_account.py
TIKTOK_ACCOUNT=

# TikTok Display API（統括/tiktok_api/）。developers.tiktok.com のアプリの値
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
